<?php

// ==========================================
// CLASS INDUK: GADGET
// ==========================================
class Gadget {
    protected $merek;
    protected $model;
    protected $harga;

    public function __construct($merek, $model, $harga) {
        $this->merek = $merek;
        $this->model = $model;
        $this->harga = $harga;
    }

    public function getMerek() {
        return $this->merek;
    }

    public function getModel() {
        return $this->model;
    }

    public function getHarga() {
        return $this->harga;
    }

    public function tampilkanInfo() {
        return "Merek: " . $this->merek .
               " | Model: " . $this->model .
               " | Harga: Rp " . number_format($this->harga, 0, ',', '.');
    }
}

// ==========================================
// CLASS ANAK 1: SMARTPHONE
// ==========================================
class Smartphone extends Gadget {
    private $kapasitas;
    private $kamera;

    public function __construct($merek, $model, $harga, $kapasitas, $kamera) {
        parent::__construct($merek, $model, $harga);
        $this->kapasitas = $kapasitas;
        $this->kamera = $kamera;
    }

    public function getKapasitas() {
        return $this->kapasitas;
    }

    public function getKamera() {
        return $this->kamera;
    }
}

// ==========================================
// CLASS ANAK 2: LAPTOP
// ==========================================
class Laptop extends Gadget {
    private $processor;
    private $ram;

    public function __construct($merek, $model, $harga, $processor, $ram) {
        parent::__construct($merek, $model, $harga);
        $this->processor = $processor;
        $this->ram = $ram;
    }

    public function getProcessor() {
        return $this->processor;
    }

    public function getRam() {
        return $this->ram;
    }
}

// ==========================================
// MEMBUAT OBJECT GADGET
// ==========================================
$smartphone1 = new Smartphone(
    "Samsung",
    "Galaxy S24 Ultra",
    18000000,
    "256 GB",
    "200 MP"
);

$smartphone2 = new Smartphone(
    "Apple",
    "iPhone 16",
    15000000,
    "128 GB",
    "48 MP"
);

$laptop1 = new Laptop(
    "ASUS",
    "ROG Zephyrus",
    22000000,
    "Intel Core i7",
    "16 GB"
);

$laptop2 = new Laptop(
    "Lenovo",
    "IdeaPad Slim 3",
    8500000,
    "AMD Ryzen 5",
    "8 GB"
);

$daftarSmartphone = [$smartphone1, $smartphone2];
$daftarLaptop = [$laptop1, $laptop2];

?>

